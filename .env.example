NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://your-server.example.com

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-server.example.com/oauth/google/callback

# Generate both with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SETUP_ADMIN_SECRET=

# SQLite must live on a persistent volume in production.
DATABASE_PATH=./data/blogger-ai-publisher.sqlite

# Restrict DCR to the exact ChatGPT callback URI shown in the connector setup.
# Default is ChatGPT's stable URI when issuer identification is supported.
CHATGPT_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Public publishing is disabled for initial testing.
PUBLISH_ENABLED=false
MAX_POSTS_PER_SEARCH=100
